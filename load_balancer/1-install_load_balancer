#!/usr/bin/env bash
# Installs HAProxy and load balances web-01 and web-02 with roundrobin
apt-get update -y
apt-get install -y haproxy
if ! grep -q "http_back" /etc/haproxy/haproxy.cfg
then
    cat >> /etc/haproxy/haproxy.cfg << 'EOF'

frontend http_front
    bind *:80
    mode http
    default_backend http_back

backend http_back
    mode http
    balance roundrobin
    server 7265-web-01 3.10.232.77:80 check
    server 7265-web-02 3.10.170.254:80 check
EOF
fi
service haproxy restart
